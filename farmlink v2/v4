class ProductAPI(APIView):
    @login_required
    def post(self, request):
        try:
            data = json.loads(request.body)
            
            # Validate required fields
            required_fields = ['name', 'price', 'unit', 'quantity', 'category', 'harvest_date']
            for field in required_fields:
                if not data.get(field):
                    return JsonResponse({'error': f'{field} is required'}, status=400)
            
            # Create product
            product = Product.objects.create(
                name=DataValidator.sanitize_input(data['name']),
                description=DataValidator.sanitize_input(data.get('description', '')),
                price=Decimal(str(data['price'])),
                unit=data['unit'],
                quantity=int(data['quantity']),
                category_id=data['category'],
                farmer=request.user,
                harvest_date=datetime.strptime(data['harvest_date'], '%Y-%m-%d').date(),
                is_organic=bool(data.get('is_organic', False)),
                grade=data.get('grade', 'standard'),
                variety=DataValidator.sanitize_input(data.get('variety', '')),
                origin_region=DataValidator.sanitize_input(data.get('origin_region', '')),
                storage_requirements=DataValidator.sanitize_input(data.get('storage_requirements', '')),
                shelf_life_days=data.get('shelf_life_days'),
