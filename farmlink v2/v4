class EnhancedOrderAPI(APIView):
    @login_required
    def post(self, request):
        try:
            data = json.loads(request.body)
            shipping_address = DataValidator.sanitize_input(data.get('shipping_address'))
            billing_address = DataValidator.sanitize_input(data.get('billing_address', shipping_address))
            notes = DataValidator.sanitize_input(data.get('notes', ''))
            discount_code = data.get('discount_code', '').strip()
            
            if not shipping_address:
                return JsonResponse({'error': 'Shipping address required'}, status=400)
            
            cart = Cart.objects.get(user=request.user, is_active=True)
            items = cart.items.select_related('product').all()
            
            if not items:
                return JsonResponse({'error': 'Cart is empty'}, status=400)
            
            with transaction.atomic():
                # Calculate subtotal
                subtotal = sum(item.unit_price * item.quantity for item in items)
                
                # Apply discount
                discount_amount = Decimal('0.00')
                discount_obj = None
                if discount_code:
                    discount_obj, discount_amount = DiscountService.apply_discount_code(
                        discount_code, subtotal, request.user
                    )
                    if discount_obj is None:
                        return JsonResponse({'error': discount_amount}, status=400)
                
                # Calculate tax
                tax_rate = request.user.country.tax_rate / 100
                tax_amount = (subtotal - discount_amount) * Decimal(str(tax_rate))
                
                # Calculate shipping cost
                shipping_cost = Decimal('100.00')
                if request.user.location and items:
                    farmer_location = items[0].product.farmer.location
                    if farmer_location:
                        total_weight = sum(
                            (item.product.weight_kg or Decimal('1.0')) * item.quantity 
                            for item in items
                        )
                        shipping_cost = GeoService.calculate_shipping_cost(
                            farmer_location, 
                            request.user.location,
                            float(total_weight)
                        )
                
                total_amount = (subtotal - discount_amount) + tax_amount + shipping_cost
                
                # Create order
                order = Order.objects.create(
                    buyer=request.user,
                    farmer=items[0].product.farmer,
                    subtotal=subtotal,
                    total_amount=total_amount,
                    tax_amount=tax_amount,
                    shipping_cost=shipping_cost,
                    discount_amount=discount_amount,
                    discount_code=discount_obj,
                    shipping_address=shipping_address,
                    billing_address=billing_address,
                    notes=notes,
                    estimated_delivery=timezone.now().date() + timedelta(days=3),
                    currency=request.user.country.currency_code,
                    source_ip=request.META.get('REMOTE_ADDR'),
                    user_agent=request.META.get('HTTP_USER_AGENT', ''),
                )
                
                # Create order items and update inventory
                for item in items:
                    OrderItem.objects.create(
                        order=order,
                        product=item.product,
                        quantity=item.quantity,
                        price=item.unit_price,
                        unit=item.product.unit
                    )
                    
                    # Update product quantity
                    item.product.quantity = F('quantity') - item.quantity
                    item.product.save()
                
                # Update discount code usage
                if discount_obj:
                    discount_obj.used_count = F('used_count') + 1
                    discount_obj.save()
                
                # Create payment intent
                payment_service = PaymentService()
                payment_intent = payment_service.create_payment_intent(
                    amount=total_amount,
                    currency=request.user.country.currency_code,
                    metadata={'order_id': order.id}
                )
                
                if not payment_intent:
                    raise Exception("Payment processing failed")
                
                order.payment_intent_id = payment_intent.id
                order.save()
                
                # Deactivate cart
                cart.is_active = False
                cart.save()
                
                # Send notifications
