    def put(self, request, item_id):
        try:
            data = json.loads(request.body)
            quantity = int(data.get('quantity', 1))
            notes = DataValidator.sanitize_input(data.get('notes', ''))
            
            if quantity <= 0:
                return JsonResponse({'error': 'Invalid quantity'}, status=400)
            
            cart = Cart.objects.get(user=request.user, is_active=True)
            cart_item = CartItem.objects.get(cart=cart, id=item_id)
            
            if cart_item.product.quantity < quantity:
                return JsonResponse({'error': 'Insufficient stock'}, status=400)
            
            cart_item.quantity = quantity
            cart_item.notes = notes
            cart_item.save()
            
            # Update cart estimated total
            cart.update_estimated_total()
            
            return JsonResponse({
                'status': 'success',
                'message': f'Updated {cart_item.product.name} quantity to {quantity}'
            })
            
        except (Cart.DoesNotExist, CartItem.DoesNotExist):
