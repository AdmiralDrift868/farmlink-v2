class EnhancedReviewAPI(APIView):
    @login_required
    def post(self, request, order_id):
        try:
            data = json.loads(request.body)
            rating = int(data.get('rating'))
            comment = DataValidator.sanitize_input(data.get('comment', ''))
            title = DataValidator.sanitize_input(data.get('title', ''))
            pros = DataValidator.sanitize_input(data.get('pros', ''))
            cons = DataValidator.sanitize_input(data.get('cons', ''))
            images = data.get('images', [])
            
            if not (1 <= rating <= 5):
                return JsonResponse({'error': 'Rating must be between 1 and 5'}, status=400)
            
            order = Order.objects.get(
                id=order_id, 
                buyer=request.user, 
                status='delivered'
            )
            
            # Create or update review
            review, created = Review.objects.update_or_create(
                order=order,
                defaults={
                    'rating': rating,
                    'comment': comment,
                    'title': title,
                    'pros': pros,
                    'cons': cons,
                    'images': images
                }
            )
            
            # Update farmer rating
            farmer = order.farmer
            farmer_reviews = Review.objects.filter(
                order__farmer=farmer
            ).aggregate(
                avg_rating=Avg('rating'),
                total_reviews=Count('id')
            )
            
            farmer.rating = farmer_reviews['avg_rating'] or 0.0
            farmer.total_reviews = farmer_reviews['total_reviews']
            farmer.save()
            
            # Send notification to farmer
            NotificationService.send_notification(
                farmer,
                f"You received a {rating}-star review from {request.user.farm_name}",
                'review',
                order.id,
                f'/farmer/orders/{order.id}'
            )
            
            return JsonResponse({
                'status': 'success',
                'message': 'Review submitted successfully'
            }, status=201)
            
        except Order.DoesNotExist:
            return JsonResponse({'error': 'Order not found or not eligible for review'}, status=404)
        except (ValueError, TypeError):
            return JsonResponse({'error': 'Invalid rating value'}, status=400)
        except Exception as e:
            logger.error(f"Review error: {str(e)}")
            return JsonResponse({'error': 'Failed to submit review'}, status=500)
    
    @login_required
    def get(self, request, order_id):
        try:
            review = Review.objects.get(order_id=order_id)
            return JsonResponse({
                'id': review.id,
