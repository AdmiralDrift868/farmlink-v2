class EnhancedCartAPI(APIView):
    @login_required
    def get(self, request):
        cart, _ = Cart.objects.get_or_create(user=request.user, is_active=True)
        items = cart.items.select_related('product', 'product__farmer').all()
        
        cart_data = {
            'id': cart.id,
            'total': str(cart.total()),
            'item_count': cart.item_count(),
            'currency': cart.currency,
            'estimated_shipping': str(Decimal('100.00')),  # Default shipping
            'estimated_tax': str(cart.total() * (request.user.country.tax_rate / 100)),
            'estimated_total': str(cart.total() * (1 + request.user.country.tax_rate / 100) + Decimal('100.00')),
            'items': [{
                'id': item.id,
                'product_id': item.product.id,
                'name': item.product.name,
                'price': str(item.product.price),
                'unit_price': str(item.unit_price),
                'quantity': item.quantity,
                'subtotal': str(item.unit_price * item.quantity),
                'farmer_name': item.product.farmer.farm_name,
                'image_url': item.product.image.url if item.product.image else None,
                'unit': item.product.unit,
                'available_quantity': item.product.quantity
            } for item in items]
        }
        return JsonResponse(cart_data)
    
    @login_required
    def post(self, request):
        try:
            data = json.loads(request.body)
            product_id = data.get('product_id')
            quantity = int(data.get('quantity', 1))
            notes = DataValidator.sanitize_input(data.get('notes', ''))
            
            if quantity <= 0:
                return JsonResponse({'error': 'Invalid quantity'}, status=400)
            
            product = Product.objects.get(id=product_id)
            
            if product.quantity < quantity:
                return JsonResponse({'error': 'Insufficient stock'}, status=400)
            
            cart, _ = Cart.objects.get_or_create(user=request.user, is_active=True)
            
            # Update or create cart item
            cart_item, created = CartItem.objects.get_or_create(
                cart=cart,
                product=product,
                defaults={
                    'quantity': quantity,
                    'notes': notes
                }
            )
            
            if not created:
                new_quantity = cart_item.quantity + quantity
                if product.quantity < new_quantity:
                    return JsonResponse({'error': 'Insufficient stock'}, status=400)
                cart_item.quantity = new_quantity
                cart_item.notes = notes
                cart_item.save()
            
            # Update cart estimated total
            cart.update_estimated_total()
            
            # Update product views
            product.views = F('views') + 1
            product.save()
            
            return JsonResponse({
                'status': 'success',
                'message': f'Added {quantity} {product.name} to cart',
                'cart_item_count': cart.item_count()
            }, status=201)
            
        except Product.DoesNotExist:
            return JsonResponse({'error': 'Product not found'}, status=404)
        except json.JSONDecodeError:
            return JsonResponse({'error': 'Invalid JSON data'}, status=400)
        except Exception as e:
            logger.error(f"Cart error: {str(e)}")
            return JsonResponse({'error': 'Failed to add item to cart'}, status=500)
    
