class Cart(models.Model):
    user = models.ForeignKey(Farmer, on_delete=models.CASCADE, related_name='carts')
    created_at = models.DateTimeField(auto_now_add=True)
    updated_at = models.DateTimeField(auto_now=True)
    is_active = models.BooleanField(default=True)
    session_key = models.CharField(max_length=40, blank=True)
    notes = models.TextField(blank=True)
    estimated_total = models.DecimalField(max_digits=10, decimal_places=2, default=0.0)
    currency = models.CharField(max_length=3, default='TTD')
    
    def total(self):
        return self.items.aggregate(
            total=Sum(F('quantity') * F('product__price'))
        )['total'] or Decimal('0.00')
    
    def item_count(self):
        return self.items.aggregate(count=Sum('quantity'))['count'] or 0
    
    def update_estimated_total(self):
        self.estimated_total = self.total()
        self.save()
    
    class Meta:
        indexes = [
            models.Index(fields=['is_active']),
            models.Index(fields=['user', 'is_active']),
            models.Index(fields=['created_at']),
        ]

