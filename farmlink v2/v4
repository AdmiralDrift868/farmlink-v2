class SearchService:
    @staticmethod
    def advanced_search(query, category=None, min_price=None, max_price=None, 
                       is_organic=None, sort_by='relevance', farmer_rating=None,
                       certifications=None, location=None, radius_km=None):
        # Use PostgreSQL full-text search if available
        if getattr(settings, 'USE_POSTGRES', False):
            search_vector = SearchVector('name', 'description', 'farmer__farm_name')
            queryset = Product.objects.annotate(search=search_vector).filter(search=query)
        else:
            # Fallback to basic search
            queryset = Product.objects.filter(
                Q(name__icontains=query) |
                Q(description__icontains=query) |
                Q(farmer__farm_name__icontains=query)
            )
        
        # Apply filters
        if category:
            queryset = queryset.filter(category__code=category)
        if min_price:
            queryset = queryset.filter(price__gte=min_price)
        if max_price:
            queryset = queryset.filter(price__lte=max_price)
        if is_organic is not None:
            queryset = queryset.filter(is_organic=is_organic)
        if farmer_rating:
            queryset = queryset.filter(farmer__rating__gte=farmer_rating)
        if certifications:
            queryset = queryset.filter(certifications__name__in=certifications)
        if location and radius_km:
            # This would require more complex geospatial queries
            pass
        
        # Apply sorting
        sort_options = {
            'price_asc': 'price',
            'price_desc': '-price',
            'date': '-created_at',
            'popularity': '-views',
            'rating': '-farmer__rating',
            'name': 'name'
        }
        if sort_by in sort_options:
            queryset = queryset.order_by(sort_options[sort_by])
        else:
            queryset = queryset.order_by('-created_at')
        
        return queryset.distinct()

