class DiscountService:
    @staticmethod
    def apply_discount_code(code, cart_total, user=None):
        try:
            discount = DiscountCode.objects.get(
                code=code,
                is_active=True,
                valid_from__lte=timezone.now(),
                valid_until__gte=timezone.now()
            )
            
            # Check usage limits
            if discount.usage_limit and discount.used_count >= discount.usage_limit:
                return None, "Discount code usage limit exceeded"
            
            # Check minimum order value
            if cart_total < discount.minimum_order_value:
                return None, f"Minimum order value is {discount.minimum_order_value}"
            
            # Calculate discount
            if discount.discount_type == 'percentage':
                discount_amount = cart_total * (discount.discount_value / 100)
            else:  # fixed amount
                discount_amount = min(discount.discount_value, cart_total)
            
            return discount, discount_amount
            
        except DiscountCode.DoesNotExist:
            return None, "Invalid discount code"
    
    @staticmethod
    def generate_discount_code(length=8):
        return ''.join(random.choices(string.ascii_uppercase + string.digits, k=length))

