class DataValidator:
    @staticmethod
    def validate_password(password):
        if len(password) < 8:
            return False, "Password must be at least 8 characters"
        if not re.search(r"[A-Z]", password):
            return False, "Password must contain an uppercase letter"
        if not re.search(r"[a-z]", password):
            return False, "Password must contain a lowercase letter"
        if not re.search(r"[0-9]", password):
            return False, "Password must contain a digit"
        if not re.search(r"[!@#$%^&*(),.?\":{}|<>]", password):
            return False, "Password must contain a special character"
        return True, ""

    @staticmethod
    def validate_email(email):
        validator = EmailValidator()
        try:
            validator(email)
            return True, ""
        except:
            return False, "Invalid email format"

    @staticmethod
    def sanitize_input(text):
        if not text:
            return text
        # Remove potentially dangerous characters
        sanitized = re.sub(r'[<>"\']', '', str(text))
        # Limit length
        return sanitized.strip()[:500]
    
    @staticmethod
    def validate_phone(phone):
        pattern = r'^\+?[\d\s\-\(\)]{10,20}$'
        return bool(re.match(pattern, phone))
    
    @staticmethod
    def validate_location(location):
        try:
            if not location:
                return False, "Location is required"
            parts = location.split(',')
            if len(parts) != 2:
                return False, "Invalid location format"
            lat, lon = float(parts[0]), float(parts[1])
            if not (-90 <= lat <= 90) or not (-180 <= lon <= 180):
                return False, "Invalid coordinates"
            return True, ""
        except:
            return False, "Invalid location format"
    
    @staticmethod
    def validate_url(url):
        validator = URLValidator()
        try:
            validator(url)
            return True, ""
        except:
            return False, "Invalid URL format"

class GeoService:
    @staticmethod
    def calculate_shipping_cost(origin, destination, weight_kg=1.0, method='standard'):
        try:
            origin_coords = tuple(map(float, origin.split(',')))
            dest_coords = tuple(map(float, destination.split(',')))
            
            distance = geodesic(origin_coords, dest_coords).kilometers
            
            # Get shipping method rates
            shipping_method = ShippingMethod.objects.filter(
                name__iexact=method,
                is_active=True
            ).first()
            
            if not shipping_method:
                shipping_method = ShippingMethod.objects.filter(is_active=True).first()
            
            if shipping_method:
                base_cost = shipping_method.base_cost
                per_km = shipping_method.cost_per_km
                cost = base_cost + (per_km * Decimal(str(distance)))
                
                # Apply weight factor
                if weight_kg > 1:
                    cost *= Decimal(str(1 + (weight_kg * 0.1)))
            else:
                # Default calculation
                base_cost = Decimal('50.00')
                per_km = Decimal('1.20')
                cost = base_cost + (per_km * Decimal(str(distance)))
            
            return max(cost, Decimal('50.00'))  # Minimum shipping cost
        except Exception as e:
            logger.error(f"Shipping cost calculation error: {str(e)}")
            return Decimal('100.00')

