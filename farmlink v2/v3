                subject,
                message,
                settings.DEFAULT_FROM_EMAIL,
                [user.email],
                html_message=html_message,
                fail_silently=True,
            )
        
        return notification

class SearchService:
    @staticmethod
    def advanced_search(query, category=None, min_price=None, max_price=None, 
                       is_organic=None, sort_by='relevance'):
        # Use PostgreSQL full-text search if available
        if getattr(settings, 'USE_POSTGRES', False):
            search_vector = SearchVector('name', 'description', 'farmer__farm_name')
            queryset = Product.objects.annotate(search=search_vector).filter(search=query)
        else:
            # Fallback to basic search
            queryset = Product.objects.filter(
                Q(name__icontains=query) |
                Q(description__icontains=query) |
                Q(farmer__farm_name__icontains=query)
            )
        
        # Apply filters
        if category:
            queryset = queryset.filter(category__code=category)
        if min_price:
            queryset = queryset.filter(price__gte=min_price)
        if max_price:
            queryset = queryset.filter(price__lte=max_price)
        if is_organic is not None:
            queryset = queryset.filter(is_organic=is_organic)
        
        # Apply sorting
        sort_options = {
            'price_asc': 'price',
            'price_desc': '-price',
            'date': '-created_at',
            'popularity': '-views',
            'rating': '-farmer__rating'
        }
        if sort_by in sort_options:
            queryset = queryset.order_by(sort_options[sort_by])
        else:
            queryset = queryset.order_by('-created_at')
        
        return queryset

class AnalyticsService:
    @staticmethod
    def get_farmer_dashboard_data(farmer):
        # Sales summary
        thirty_days_ago = timezone.now() - timedelta(days=30)
        orders = Order.objects.filter(
            farmer=farmer,
            created_at__gte=thirty_days_ago
        )
        
        total_sales = orders.aggregate(
            total=Sum('total_amount')
        )['total'] or Decimal('0.00')
        
        order_count = orders.count()
        
        # Recent orders
        recent_orders = orders.order_by('-created_at')[:10].values(
            'id', 'created_at', 'total_amount', 'status', 'buyer__farm_name'
        )
        
        # Top products
        top_products = OrderItem.objects.filter(
            order__farmer=farmer,
            order__created_at__gte=thirty_days_ago
        ).values('product__name').annotate(
            total_quantity=Sum('quantity'),
            total_revenue=Sum(F('quantity') * F('price'))
        ).order_by('-total_revenue')[:5]
        
        # Monthly trend
        monthly_data = orders.extra(
            select={'month': "EXTRACT(month FROM created_at)"}
        ).values('month').annotate(
            total=Sum('total_amount'),
            count=Count('id')
        ).order_by('month')
        
        return {
            'total_sales': total_sales,
            'order_count': order_count,
            'recent_orders': list(recent_orders),
            'top_products': list(top_products),
            'monthly_trend': list(monthly_data)
        }

